<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- JARVIS SHILATECH MSI installer, WiX Toolset v3.11+. -->
  <Product Id="*" Name="JARVIS - SHILATECH - Personal AI, On Personal Devices"
           Language="1033" Version="$(var.ProductVersion)" Manufacturer="SHILATECH"
           UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Description="JARVIS SHILATECH — Local-first Personal AI"
             Comments="Apache 2.0 License SHILATECH" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="JARVIS SHILATECH" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ConfigExample" />
      <ComponentRef Id="PathEnv" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AutoStart" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="deploy/windows/license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="deploy/windows/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="deploy/windows/dialog.bmp" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="JARVIS SHILATECH" />
      </Directory>
      <!-- Machine-wide Start Menu location keeps this component per-machine. -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="ProgramDataMicrosoft" Name="Microsoft">
          <Directory Id="ProgramDataWindows" Name="Windows">
            <Directory Id="ProgramDataStartMenu" Name="Start Menu">
              <Directory Id="ProgramDataPrograms" Name="Programs">
                <Directory Id="JARVISStartMenuFolder" Name="JARVIS SHILATECH" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="JarvisExe" Source="dist\jarvis.exe" KeyPath="yes" />
      </Component>
      <Component Id="ConfigExample" Guid="*">
        <File Id="ConfigToml" Source="configs\jarvis\config.example.toml" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="JARVISStartMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="JARVIS SHILATECH"
                  Description="Personal AI, voice works online and offline"
                  Target="[INSTALLFOLDER]jarvis.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="ApplicationChatShortcut" Name="JARVIS Chat SHILATECH"
                  Description="Interactive JARVIS chat" Target="[INSTALLFOLDER]jarvis.exe"
                  Arguments="chat --interactive" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallProduct" Name="Uninstall JARVIS SHILATECH"
                  Description="Uninstall JARVIS SHILATECH" Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanUpShortCut" Directory="JARVISStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\SHILATECH\JARVIS" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="TARGETDIR">
      <Component Id="AutoStart" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="JARVIS SHILATECH"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]jarvis.exe&quot;"
                       KeyPath="yes" />
      </Component>
      <Component Id="PathEnv" Guid="*">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                     Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\SHILATECH\JARVIS" Name="path"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>